# Backend required in production
MONGODB_URI=
JWT_SECRET=
OTP_HASH_SECRET=
ADMIN_EMAILS=
FRONTEND_URL=
API_URL=

# Optional providers; configure every variable in a provider group or leave all blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Development only. Production seeding is rejected.
NODE_ENV=development
SEED_MONGO=false
PORT=3001
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Frontend; required for production builds. Use /api proxy in local development or a full URL.
VITE_API_BASE=
